{
  "name": "fquad-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "cms:prune": "tsx prisma/prune-legacy-content.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "npx --yes tsx prisma/seed.ts",
    "admin:password": "node scripts/set-admin-password.mjs",
    "hero:avif": "node scripts/encode-hero-avif.mjs",
    "sketch:images": "node scripts/make-sketches.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "gsap": "^3.12.7",
    "jose": "^6.2.9",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "resend": "^6.20.0",
    "sharp": "^0.35.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
