rules_version = '2';

// The website reads and writes Firestore only from its own server, with the
// Admin SDK, which is not subject to these rules. Nothing is meant to be
// reachable straight from a browser, so every client request is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
