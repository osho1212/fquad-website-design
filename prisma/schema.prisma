// F.QUAD Studio Admin — Database Schema
// SQLite via Prisma. Run `npx prisma db push` after editing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN") // "SUPERADMIN" | "ADMIN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============ MEDIA LIBRARY ============

model Media {
  id        String         @id @default(cuid())
  type      String         // "IMAGE" | "VIDEO"
  filename  String
  path      String
  alt       String?
  width     Int?
  height    Int?
  duration  Int?           // seconds, for video
  variants  MediaVariant[]
  createdAt DateTime       @default(now())

  // back-relations from places that reference media
  projectCovers ProjectMedia[] @relation("ProjectGalleryMedia")
  coveredBy     Project[]      @relation("ProjectCover")
  logoDarkFor   SiteSettings[] @relation("LogoDark")
  logoLightFor  SiteSettings[] @relation("LogoLight")
  ogImageFor    SiteSettings[] @relation("OgImage")
  testimonials  Testimonial[]
  teamMembers   TeamMember[]
  blogPosts     BlogPost[]
  heroSlides    HeroSlide[]
  projectTestimonials ProjectTestimonial[]
  folderId      String?
  folder        MediaFolder?   @relation("FolderMedia", fields: [folderId], references: [id])
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  projectId String?
  media     Media[]  @relation("FolderMedia")
  createdAt DateTime @default(now())
}

model MediaVariant {
  id      String @id @default(cuid())
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  label   String // "thumb" | "grid" | "full" | "poster" | "webp" | "compressed"
  path    String
  width   Int?
  height  Int?
  format  String // "jpg" | "webp" | "mp4"

  @@unique([mediaId, label])
}

// ============ PROJECTS ============

model Category {
  id       String    @id @default(cuid())
  name     String    @unique // "Residential", "Commercial", "Hospitality", "Landscape"
  slug     String    @unique
  order    Int       @default(0)
  projects Project[]
}

model MainCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  order    Int       @default(0)
  projects Project[]
}

model Project {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  category      Category       @relation(fields: [categoryId], references: [id])
  categoryId    String
  mainCategoryId   String?
  mainCategory     MainCategory? @relation(fields: [mainCategoryId], references: [id])
  subCategory      String?
  shortDescription String?
  clientName       String?
  clientAddress    String?
  hasInteriors     Boolean @default(false)
  hasArchitecture  Boolean @default(false)
  linkedProjectId  String?
  location      String?
  mapLat        Float?
  mapLng        Float?
  showLocation  Boolean        @default(false)
  year          Int?
  description   String?
  coverMediaId  String?
  coverMedia    Media?         @relation("ProjectCover", fields: [coverMediaId], references: [id])
  gallery       ProjectMedia[]
  testimonials  ProjectTestimonial[]
  featured      Boolean        @default(false)
  published     Boolean        @default(true)
  status        String         @default("PUBLISHED")
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media   @relation("ProjectGalleryMedia", fields: [mediaId], references: [id])
  order     Int     @default(0)
  areaLabel String?
}

// ============ PAGE CONTENT ============
// One row per editable block. `data` shapes are documented in lib/content-types.ts

model PageContent {
  page      String // "home" | "projects" | "about" | "services" | "contact"
  section   String // "hero" | "stats" | "portfolio_intro" | "services" | "process" | "testimonial" | "cta" | "banner"
  data      String // JSON string (SQLite has no native JSON type)
  updatedAt DateTime @updatedAt

  @@id([page, section])
}

// ============ SITE SETTINGS ============

model SiteSettings {
  id              String  @id @default("default")
  siteName        String  @default("F.QUAD")
  logoDarkId      String?
  logoDark        Media?  @relation("LogoDark", fields: [logoDarkId], references: [id])
  logoLightId     String?
  logoLight       Media?  @relation("LogoLight", fields: [logoLightId], references: [id])
  email           String?
  phone           String?
  whatsapp        String?
  address         String?
  instagramUrl    String?
  mapLat          Float?
  mapLng          Float?
  metaTitle       String?
  metaDescription String?
  ogImageId       String?
  ogImage         Media?  @relation("OgImage", fields: [ogImageId], references: [id])
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  whatsapp  Boolean  @default(false)
  status    String   @default("NEW") // "NEW" | "CONTACTED" | "CLOSED"
  createdAt DateTime @default(now())
}

// ============ TESTIMONIALS / AWARDS / TEAM / BLOG ============

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  projectName String?
  quote       String
  mediaId     String?
  media       Media?   @relation(fields: [mediaId], references: [id])
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model ProjectTestimonial {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientName      String
  clientAddress   String?
  testimonialText String
  mediaId         String?
  media           Media?   @relation(fields: [mediaId], references: [id])
  createdAt       DateTime @default(now())
}

model Award {
  id        String   @id @default(cuid())
  year      Int
  title     String
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  linkedIn  String?
  mediaId   String?
  media     Media?   @relation(fields: [mediaId], references: [id])
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model HeroSlide {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id])
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  body        String
  mediaId     String?
  media       Media?    @relation(fields: [mediaId], references: [id])
  published   Boolean   @default(false)
  publishedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
}