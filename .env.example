# Environment template.
#
# Local development: copy to `.env.local`.
# Vercel: add the same names under Project → Settings → Environment Variables.
#
# NEVER commit the filled-in file — it holds secrets. `.env*` is gitignored.

# ═════════════════════════════════════════════════════════════
# Firebase (Firestore for data, Cloud Storage for pictures and plans)
# ═════════════════════════════════════════════════════════════
# Firebase console → Project settings → Service accounts → Generate new private
# key. Paste the WHOLE contents of the downloaded JSON file as the value.
FIREBASE_SERVICE_ACCOUNT=
# Instead of the JSON, you may set these three:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Firebase console → Storage: the bucket's name, e.g. my-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# ── Local development without a real Firebase project: the emulators ──
# `npm run emulators` starts a local Firestore and Cloud Storage (needs Java).
# Uncomment these (and leave the service account empty) to use them.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# GCLOUD_PROJECT=demo-fquad
# FIREBASE_STORAGE_BUCKET=demo-fquad.appspot.com
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-fquad

# ═════════════════════════════════════════════════════════════
# "Continue with Google" on the admin login (optional)
# ═════════════════════════════════════════════════════════════
# Normally NOTHING needs setting here: the site finds the Firebase web app's public
# API key itself, using FIREBASE_SERVICE_ACCOUNT, and the project id and auth domain
# follow from it. Set the key only to override that (it is public by design: it names
# the Firebase project, it does not unlock it):
#   firebase apps:sdkconfig web <app-id> --project <project-id>
# Read when the login page is served, so changing it needs a redeploy, not a rebuild.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ═════════════════════════════════════════════════════════════
# Admin sessions — REQUIRED in production
# ═════════════════════════════════════════════════════════════
# At least 32 random characters. The site refuses to serve the admin without it.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# ═════════════════════════════════════════════════════════════
# Public address — REQUIRED in production
# ═════════════════════════════════════════════════════════════
# The live domain, no trailing slash. Used for canonical links, the sitemap
# and share cards. Without it they all point at http://localhost:3002.
NEXT_PUBLIC_SITE_URL=https://fquadstudio.com

# ═════════════════════════════════════════════════════════════
# Launch moment (optional)
# ═════════════════════════════════════════════════════════════
# Until this instant every public page is held behind the launch gate, which
# counts down and then opens the site. Defaults to 2026-11-11T11:11:00+05:30
# — 11:11 on 11/11, which is what the gate's closing mark is built around.
# Keep the offset — a bare local time means a different moment on every device.
# To take the gate down for good, set it to a time already past.
#   Studio preview before launch:  https://fquadstudio.com/?skiplaunch
#   Replay the sequence (dev):     the button on the gate, or ?dev in the URL
# NEXT_PUBLIC_LAUNCH_AT=2026-11-11T11:11:00+05:30

# ═════════════════════════════════════════════════════════════
# Google Search Console (optional)
# ═════════════════════════════════════════════════════════════
# The token from Search Console → Settings → Ownership verification → HTML tag
# (the value of its content="…" attribute).
GOOGLE_SITE_VERIFICATION=

# ═════════════════════════════════════════════════════════════
# Email (Resend) — https://resend.com/api-keys
# ═════════════════════════════════════════════════════════════
RESEND_API_KEY=
# The sender's domain must be verified in Resend (SPF + DKIM DNS records).
MAIL_FROM="F.QUAD Studio <contact@fquadstudio.com>"
# Where new enquiries are emailed. NO DEFAULT: leave it empty and nothing is emailed
# (enquiries are still saved and shown in Admin → Enquiries). Use a mailbox that exists.
ENQUIRY_TO=

# ═════════════════════════════════════════════════════════════
# First admin account — used once, by `npm run db:seed`
# ═════════════════════════════════════════════════════════════
# There is deliberately no default password. Use a unique one (12+ characters),
# then remove these two lines. Change it any time under Admin → Account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
