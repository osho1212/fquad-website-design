# Environment template.
#
# Local development: copy to `.env.local`.
# Production server: copy to `.env` in the project folder (the Prisma command
# line reads `.env`, not `.env.local`, so one `.env` keeps the app and the
# `prisma` commands in agreement).
#
# NEVER commit the filled-in file — it holds secrets. Both are gitignored.

# ═════════════════════════════════════════════════════════════
# Database (SQLite via Prisma)
# ═════════════════════════════════════════════════════════════
# Development (a fresh clone has no database: run `npm run db:migrate`, then
# `ADMIN_EMAIL=… ADMIN_PASSWORD=… npm run db:seed` to create it and the first admin):
DATABASE_URL="file:./dev.db"
# Production — keep the database OUTSIDE the project folder so a redeploy
# can never overwrite it (see SERVER_SETUP.md):
# DATABASE_URL="file:/var/data/fquad/app.db"

# ═════════════════════════════════════════════════════════════
# Admin sessions — REQUIRED in production
# ═════════════════════════════════════════════════════════════
# At least 32 random characters. The site refuses to serve the admin without it.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# ═════════════════════════════════════════════════════════════
# Public address — REQUIRED in production
# ═════════════════════════════════════════════════════════════
# The live domain, no trailing slash. Used for canonical links, the sitemap
# and share cards. Without it they all point at http://localhost:3002.
NEXT_PUBLIC_SITE_URL=https://fquad.com

# ═════════════════════════════════════════════════════════════
# Google Search Console (optional)
# ═════════════════════════════════════════════════════════════
# The token from Search Console → Settings → Ownership verification → HTML tag
# (the value of its content="…" attribute).
GOOGLE_SITE_VERIFICATION=

# ═════════════════════════════════════════════════════════════
# Email (Resend) — https://resend.com/api-keys
# ═════════════════════════════════════════════════════════════
RESEND_API_KEY=
# The sender's domain must be verified in Resend (SPF + DKIM DNS records).
MAIL_FROM="F.QUAD Studio <contact@fquad.com>"
# Where new enquiries are emailed.
ENQUIRY_TO=admin@fquad.com

# ═════════════════════════════════════════════════════════════
# Files (production: persistent folders outside the project)
# ═════════════════════════════════════════════════════════════
# CMS media library (images and video) and the URL Nginx serves it from.
# MEDIA_DIR=/var/data/fquad/media
# MEDIA_URL_PREFIX=/uploads
# Plans and drawings attached to the Start a Project form. Private: never
# served directly, only to a signed-in admin.
# PRIVATE_UPLOAD_DIR=/var/data/fquad/private-uploads

# ═════════════════════════════════════════════════════════════
# First admin account — used once, by `npm run db:seed`
# ═════════════════════════════════════════════════════════════
# There is deliberately no default password. Use a unique one (12+ characters),
# then remove these two lines. Change it any time under Admin → Account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
