# .env.local
# Copy this file, rename to .env.local, and fill in your actual values
# NEVER commit .env.local to version control

# ═════════════════════════════════════════════════════════════
# RESEND API - Email Sending
# ═════════════════════════════════════════════════════════════
# Get free API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# ═════════════════════════════════════════════════════════════
# Database - SQLite (Prisma)
# ═════════════════════════════════════════════════════════════
DATABASE_URL="file:./dev.db"

# ═════════════════════════════════════════════════════════════
# Admin / CMS
# ═════════════════════════════════════════════════════════════
# Long random string used to sign admin session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Used only by `npm run db:seed` to create the first admin user.
# Change the password after first login.
ADMIN_EMAIL=admin@fquad.com
ADMIN_PASSWORD=changeme123

# ═════════════════════════════════════════════════════════════
# Add to .gitignore to never commit API keys:
# .env.local
# .env*.local
# ═════════════════════════════════════════════════════════════

